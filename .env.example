# Copie para .env.local no desenvolvimento. Na Vercel, cadastre em Settings → Environment Variables.

# Banco de dados. Na Vercel, ligue o Neon pelo Marketplace (ele cria DATABASE_URL sozinho).
# No seu computador, use o banco local embutido:
DATABASE_URL=pglite:./.data/dev

# Login do painel
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-um-texto-aleatorio-com-pelo-menos-32-caracteres

# Endereço público do app (sem barra no final). Ex.: https://zap-business-flow.vercel.app
APP_URL=http://localhost:3000
# Outros endereços onde o painel abre, separados por vírgula (opcional). Ex.: painel.minhaagencia.com.br
APP_HOSTS=

# Busca de empresas (Apify → Settings → Integrations → API token)
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=gere-outro-texto-aleatorio
# Opcional: outro coletor do Google Maps
APIFY_ACTOR=compass~crawler-google-places

# Gemini (Google AI Studio → Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Upload de fotos: ligue o Vercel Blob no projeto (ele cria BLOB_READ_WRITE_TOKEN sozinho)
BLOB_READ_WRITE_TOKEN=

# Domínios dos clientes (Vercel → Account Settings → Tokens; IDs em Project Settings)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Cron (a Vercel envia este valor no cabeçalho Authorization)
CRON_SECRET=gere-mais-um-texto-aleatorio

# WhatsApp (Evolution API no Railway)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=zapflow
WHATSAPP_WEBHOOK_SECRET=gere-mais-um-texto-aleatorio
